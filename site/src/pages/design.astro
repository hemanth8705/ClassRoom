---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { icons } from '../components/Sprite.astro';

const tokens = [
  ['bg', 'Page'], ['card', 'Surface'], ['card-2', 'Raised'], ['line', 'Hairline'], ['ink', 'Text'],
  ['muted', 'Muted'], ['accent2', 'Secondary'],
];
---
<Base title="Design" description="The palette, type, icons and components this site is built from.">
  <div class="container">
    <header class="page-head">
      <div><span class="eyebrow">Design system</span></div>
      <h1 class="display" style="margin-top:18px">Black, white, <em>precise.</em></h1>
      <p class="lead">Everything on this site is built from the tokens below. Pure black and white, no colour, so the type and the content carry the page.</p>
    </header>

    <div class="spec">

      <div class="block">
        <h3>Colour tokens (live)</h3>
        <div class="swatches">
          {tokens.map(([v, label]) => (
            <div class="sw"><i style={`background:var(--${v})`}></i><b>{label}</b><span>--{v}</span></div>
          ))}
        </div>
      </div>

      <div class="block">
        <h3>Type</h3>
        <div class="type-row"><span style="font:400 3.2rem/1 var(--serif)">Display <em style="color:var(--accent)">italic</em></span><small>Instrument Serif · headlines</small></div>
        <div class="type-row"><span style="font:400 1.06rem/1.7 var(--sans);max-width:560px">Body copy is set in Inter at a comfortable measure, so long explanations stay easy on the eyes.</span><small>Inter · body, UI</small></div>
        <div class="type-row"><span style="font:400 .9rem var(--mono);color:var(--accent)">POST /token · grant_type=authorization_code</span><small>JetBrains Mono · code, labels</small></div>
      </div>

      <div class="block">
        <h3>Icons</h3>
        <p style="color:var(--muted);margin:0 0 18px;font-size:.92rem">One 24px grid, 1.6px stroke, round caps. Always <code>currentColor</code>. No emoji anywhere.</p>
        <div class="icon-grid">
          {Object.keys(icons).map((n) => (
            <div class="icon-cell"><span class="ico-tile"><Icon name={n} /></span>{n}</div>
          ))}
        </div>
      </div>

      <div class="block">
        <h3>Buttons and labels</h3>
        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
          <a class="btn-s" href="#">Primary <Icon name="arrowRight" /></a>
          <a class="btn-s ghost" href="#">Ghost</a>
          <span class="chip-s on">Interactive</span>
          <span class="chip-s">Article</span>
          <span class="eyebrow">Eyebrow label</span>
        </div>
      </div>
    </div>
  </div>
</Base>
