---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/article.css';
import Sprite from '../components/Sprite.astro';
import { site } from '../data/site';

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const path = Astro.url.pathname;
const nav = [
  ['/articles', 'Articles'],
  ['/design', 'Design'],
  ['/about', 'About'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <script is:inline>
    // Set the theme before first paint so there is no flash. Dark is the default.
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; } catch (e) { document.documentElement.dataset.theme = 'dark'; }
  </script>
</head>
<body>
  <Sprite />
  <header class="site">
    <div class="container in">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <img class="mark" src="/avatar.png" alt="" width="32" height="32" />
        <span class="name">{site.name}</span>
      </a>
      <nav class="main" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} class={path.startsWith(href) ? 'on' : ''}>{label}</a>)}
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light mode">
        <svg class="ico sun"><use href="#i-sun" /></svg>
        <svg class="ico moon"><use href="#i-moon" /></svg>
        <span class="thumb"></span>
      </button>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site">
    <div class="container in">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Set in Instrument Serif, Inter and JetBrains Mono</span>
    </div>
  </footer>

  <script is:inline>
    // Light / dark switch. aria-checked is "true" when light is on.
    (function () {
      var btn = document.getElementById('theme-toggle');
      function sync() { btn.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'light')); }
      btn.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync();
      });
      sync();
    })();
  </script>

  <script is:inline>
    // Hover (or focus, or tap) a .term to read its definition. The box stays open while you read it.
    // Definitions live in window.GLOSSARY, filled in by each article: { key: { t, d, q } }.
    (function () {
      var pop = document.createElement('div');
      pop.className = 'term-pop'; pop.hidden = true; pop.setAttribute('role', 'dialog');
      document.body.appendChild(pop);
      var timer = null, current = null;

      function place(el) {
        var r = el.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight;
        var x = Math.min(Math.max(12, r.left), window.innerWidth - w - 12);
        var y = r.bottom + 8;
        if (y + h > window.innerHeight - 12) y = Math.max(12, r.top - h - 8);
        pop.style.left = x + 'px'; pop.style.top = y + 'px';
      }
      function show(el) {
        var g = (window.GLOSSARY || {})[el.getAttribute('data-term')];
        if (!g) return;
        clearTimeout(timer); current = el;
        pop.innerHTML = '<b></b><p></p><a target="_blank" rel="noopener"></a>';
        pop.firstChild.textContent = g.t;
        pop.children[1].textContent = g.d;
        var a = pop.children[2];
        a.href = 'https://www.google.com/search?q=' + encodeURIComponent(g.q);
        a.innerHTML = 'Explain ' + g.t.replace(/</g, '&lt;') + ' <svg class="ico"><use href="#i-arrowUpRight"/></svg>';
        pop.hidden = false; place(el);
      }
      function hideSoon() { clearTimeout(timer); timer = setTimeout(function () { pop.hidden = true; current = null; }, 200); }
      function termOf(n) { return n && n.closest ? n.closest('.term') : null; }
      function inPop(n) { return n && n.closest ? n.closest('.term-pop') : null; }

      document.addEventListener('mouseover', function (e) {
        var t = termOf(e.target);
        if (t) show(t); else if (inPop(e.target)) clearTimeout(timer);
      });
      document.addEventListener('mouseout', function (e) { if (termOf(e.target) || inPop(e.target)) hideSoon(); });
      document.addEventListener('focusin', function (e) { var t = termOf(e.target); if (t) show(t); });
      document.addEventListener('focusout', function (e) { if (termOf(e.target)) hideSoon(); });
      document.addEventListener('click', function (e) {          // touch screens: tap to open, tap elsewhere to close
        var t = termOf(e.target);
        if (t) { current === t && !pop.hidden ? (pop.hidden = true) : show(t); }
        else if (!inPop(e.target)) pop.hidden = true;
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') pop.hidden = true; });
      window.addEventListener('scroll', function () { if (!pop.hidden && current) place(current); }, true);
    })();
  </script>
</body>
</html>
