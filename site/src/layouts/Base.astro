---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/article.css';
import Sprite from '../components/Sprite.astro';
import { site } from '../data/site';

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const path = Astro.url.pathname;
const nav = [
  ['/articles', 'Articles'],
  ['/design', 'Design'],
  ['/about', 'About'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  </head>
<body>
  <Sprite />
  <header class="site">
    <div class="container in">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <img class="mark" src="/avatar.png" alt="" width="32" height="32" />
        <span class="name">{site.name}</span>
      </a>
      <nav class="main" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} class={path.startsWith(href) ? 'on' : ''}>{label}</a>)}
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site">
    <div class="container in">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Set in Instrument Serif, Inter and JetBrains Mono</span>
    </div>
  </footer>

</body>
</html>
